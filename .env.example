# AutoLift API + frontends env (example for instantgis.cloud)
# Copy this file to `.env` and fill in all CHANGE_ME values.

# Internal Supabase URL (via supabase_default network)
SUPABASE_URL=http://kong:8000

# Supabase keys (from your Supabase stack)
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_SERVICE_ROLE_KEY
SUPABASE_ANON_KEY=CHANGE_ME_ANON_KEY

# Public URLs used by booking + rules-admin
PUBLIC_SUPABASE_URL=https://supabase.instantgis.cloud
API_BASE_URL=https://api.instantgis.cloud

# QR token + webhook secrets (generated; keep private)
QR_TOKEN_SECRET=CHANGE_ME_QR_TOKEN_SECRET
WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET

# Email configuration (Matoba SMTP or equivalent)
EMAIL_PROVIDER=matoba
MATOBA_HOST=CHANGE_ME_SMTP_HOST
MATOBA_PORT=465
MATOBA_SECURE=true
MATOBA_USER=CHANGE_ME_SMTP_USER
MATOBA_PASSWORD=CHANGE_ME_SMTP_PASSWORD

# Optional error tracking (Sentry DSN)
SENTRY_DSN=

# Triplit (real-time DB) – JWT secret for token generation
TRIPLIT_JWT_SECRET=CHANGE_ME_TRIPLIT_JWT_SECRET
# External JWT secret (Supabase JWT signing secret) - allows Triplit to verify Supabase access tokens
# Copy this from your Supabase project: Settings > API > JWT Secret
TRIPLIT_EXTERNAL_JWT_SECRET=CHANGE_ME_SUPABASE_JWT_SECRET
