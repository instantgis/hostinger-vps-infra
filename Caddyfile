# Auto-generated from template - DO NOT EDIT MANUALLY
# Domain: instantgis.cloud

# API subdomain - Fastify API
api.instantgis.cloud {
	encode gzip zstd
	# Allow only localhost dev and the booking/rules frontends to call the API from the browser
	@api_cors {
		header_regexp Origin ^http://localhost:4200$|^https://booking\.instantgis.cloud$|^https://rules\.instantgis.cloud$
	}
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
	}
	header @api_cors {
		Access-Control-Allow-Origin "{http.request.header.Origin}"
		Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
		Access-Control-Allow-Headers "Authorization, Content-Type, apikey, X-Client-Info, X-Requested-With, sentry-trace, baggage, Range, Accept-Profile, Content-Profile, Prefer, Content-Length"
		Access-Control-Expose-Headers "Content-Range, Range-Unit"
	}
	@supabase path /rest/* /auth/* /storage/* /realtime/* /functions/* /analytics/* /pg/*
	redir @supabase https://supabase.instantgis.cloud{uri} 308
	reverse_proxy api:3000 {
		# Strip Fastify's CORS headers from the response
		header_down -Access-Control-Allow-Origin
		header_down -Access-Control-Allow-Methods
		header_down -Access-Control-Allow-Headers
		header_down -Access-Control-Allow-Credentials
		header_down -Access-Control-Allow-Expose-Headers
	}
}

