# Triplit services - optional, deploy with --profile triplit
# Domain: {{DOMAIN}}

# Triplit Server - Real-time sync database
triplit.{{DOMAIN}} {
    reverse_proxy triplit-server:8080
    encode gzip zstd
    header {
        -Server
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
    }
}

# Triplit Console - Admin UI for Triplit
triplit-console.{{DOMAIN}} {
    reverse_proxy triplit-console:80
    encode gzip zstd
    header {
        -Server
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
    }
}

